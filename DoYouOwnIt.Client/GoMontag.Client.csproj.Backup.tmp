<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
	<TargetFramework>net10.0</TargetFramework>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
	<PublishTrimmed>true</PublishTrimmed>
	<PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>

	<ItemGroup>
		<PackageReference Include="AngleSharp" Version="1.4.0" />
		<PackageReference Include="Blazored.LocalStorage" Version="4.5.0" />
		<PackageReference Include="Blazored.Typeahead" Version="4.7.0" />
		<PackageReference Include="Blazorise.Captcha" Version="2.1.3" />
		<PackageReference Include="Blazorise.Captcha.ReCaptcha" Version="2.1.3" />
		<PackageReference Include="BlazorTextDiff" Version="2026.2.23.33037" />
		<PackageReference Include="GoogleCaptchaComponent" Version="6.0.0" />
		<PackageReference Include="Mapster" Version="10.0.7" />
		<PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.8" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="10.0.8" />
		<PackageReference Include="Sqids" Version="3.2.1" />
		<PackageReference Include="Syncfusion.DocIO.NET" Version="33.2.8" />
		<PackageReference Include="Azure.Storage.Blobs" Version="12.28.0" />
	</ItemGroup>

  <ItemGroup>
	<PackageReference Include="Microsoft.AspNetCore.Components.QuickGrid" Version="10.0.8" />
	<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.8" />
	<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.8" PrivateAssets="all" />
	<PackageReference Include="Syncfusion.Blazor.Core" Version="33.2.8" />
	<PackageReference Include="Syncfusion.Blazor.RichTextEditor" Version="33.2.8" />
	<PackageReference Include="Syncfusion.Blazor.Themes" Version="33.2.8" />
	<PackageReference Include="Syncfusion.EJ2.PdfViewer.AspNet.Core" Version="33.2.8" />
	<PackageReference Include="Syncfusion.HtmlToPdfConverter.Net.Windows" Version="33.2.8" />
	<PackageReference Include="Syncfusion.Licensing" Version="33.2.8" />
	<PackageReference Include="Syncfusion.Pdf.Net.Core" Version="33.2.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EasyAppDev.Blazor.AutoComplete-main\src\EasyAppDev.Blazor.AutoComplete.OData\EasyAppDev.Blazor.AutoComplete.OData.csproj" />
    <ProjectReference Include="..\EasyAppDev.Blazor.AutoComplete-main\src\EasyAppDev.Blazor.AutoComplete\EasyAppDev.Blazor.AutoComplete.csproj" />
    <ProjectReference Include="..\DoYouOwnIt,Shared\DoYouOwnIt,Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Shared\Test\" />
  </ItemGroup>

</Project>
