@inject IJSRuntime JS
@inject IUserTimeZoneService TimeZoneService
@inherits LayoutComponentBase
<div class="page">
    <AuthorizeView Roles="Admin">
        <Authorized>
            <div class="sidebar">
                <AdminNavMenu />
            </div>
        </Authorized>
    </AuthorizeView>
        
    <main>
        <div class="top-row">
            <nav class="navbar navbar-expand-lg bg-body-tertiary">
                <div class="container-fluid">
                    <a class="navbar-brand" href="">
                        <img src="https://images.gmntgstrg.com/defaultandresourceimages/DoYouOwnIt-02_fit.svg" alt="Logo" width="174" height="42" class="d-inline-block">
                        
                    </a>
                </div>
            </nav>
            <LoginDisplay />
        </div>
        <div class="site-navs">
            <nav class="nav justify-content-center">
                <a class="nav-link" href="">Home</a>
                <a class="nav-link" href="/about">About This Site</a>
                <a class="nav-link" href="/contact">Contact Me</a>
                <a class="nav-link" href="/site-news">Blog</a>
                <a class="nav-link" href="/control-your-internet">Take Back Your Internet</a>
            </nav>
        </div>

        <article class="content px-4">
            @Body
        </article>
        <br />
        <footer class="footer px-4 py-4">
            <h4>Follow Us</h4>
            <a class="btn btn-outline-primary" href="javascript:void(0)" title="Facebook"><i class="bi bi-facebook"></i></a>
            <a class="btn btn-outline-primary" href="https://DoYouOwnIt.bsky.social" title="Bluesky"><i class="bi bi-bluesky"></i></a>
            <a class="btn btn-outline-primary" href="https://x.com/DoYouOwnIt" title="Twitter"><i class="bi bi-twitter-x"></i></a>
            <a class="btn btn-outline-primary" href="javascript:void(0)" title="Instagram"><i class="bi bi-instagram"></i></a>
            <p>
                About: <a href="/about">Learn More About DoYouOwnIt</a><br />
                Contact: <a href="/contact">Email Me Here</a><br />
                Powered by Andy<br />
                © 2026 Andy. All rights reserved.<br />
                <strong>Credits: </strong> <a href="/credits">See all credits and attributes here.</a>
            </p>
        </footer>
    </main>
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var tz = await JS.InvokeAsync<string>("getTimeZone");
            TimeZoneService.TimeZoneId = tz ?? "UTC";
            StateHasChanged();
        }
    }
}