@page "/users/{UserName}"
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<UserCustomize> Logger
@inject IUserService UserService
@attribute [AllowAnonymous]

<div class="site-grid">
	<div class="left-column"></div>
	<div class="main-content-column">
		@if (isLoading)
		{
			<p><strong>Loading Profile Please Wait...</strong></p>
			<div class="spinner-border" role="status">
				<span class="visually-hidden">Loading...</span>
			</div>
		}
		else
		{
			@if (user == null)
			{
				<p>User not found.</p>
			}
			else
			{
				@if (!String.IsNullOrEmpty(user.Value.DisplayName))
				{
					<PageTitle>@user.Value.DisplayName's Profile - DoYouOwnIt</PageTitle>
				}
				else
				{
					<PageTitle>@user.Value.UserName's Profile - DoYouOwnIt</PageTitle>
				}
				<nav aria-label="breadcrumb">
					<ol class="breadcrumb">
						<li class="breadcrumb-item"><a href="/">Home</a></li>
						<li class="breadcrumb-item active">@UserName's Page</li>
					</ol>
				</nav>
				<div class="user-image">
					@if (!String.IsNullOrEmpty(user.Value.ProfileImageURL))
					{
						<div>
							<img src="@user.Value.ProfileImageURL" alt="Profile Image" class="avatar" style="max-width: 150px; max-height: 150px;" />
						</div>
					}
					else
					{
						<div>
							<img src="https://images.gmntgstrg.com/defaultandresourceimages/user.png" alt="User account icons created by Luch Phou" class="avatar" style="max-width: 150px; max-height: 150px;" />
						</div>
					}
				</div>
				<div class="user-information">
					@if (!String.IsNullOrEmpty(user.Value.DisplayName))
					{
						<h2>@user.Value.DisplayName's Profile </h2>
						<h3>(@user.Value.UserName)</h3>
					}
					else
					{
						<h2>@user.Value.UserName's Profile</h2>
					}
					<div class="user-role">
						@if (!string.IsNullOrEmpty(userRole))
						{
							<p><strong>Role: <u>@userRole</u></strong></p>
						}
						else
						{
							<p><strong>Role: <u>User</u></strong></p>
						}
					</div>
					<p><strong>Joined On:</strong> @user.Value.CreatedAt.ToString("MMMM dd, yyyy")</p>
					@if (!String.IsNullOrEmpty(user.Value.WebsiteURL))
					{
						<p><strong>Website:</strong><a target="_blank" rel="noopener noreferrer" href="@user.Value.WebsiteURL">@user.Value.WebsiteURL</a></p>
					}
				</div>
				<div class="user-ban">
					@if (user.Value.IsBanned)
					{
						<p class="text-danger"><strong>This user is banned.</strong></p>
						<p><strong>Ban Reason:</strong> @user.Value.BanReason</p>
						<p><strong>Banned Expires:</strong> @user.Value.BanEndDate?.ToString("MMMM dd, yyyy")</p>
					}
				</div>
				<div class="user-bio">
					<p>
						<strong>Bio:</strong><br />
						@user.Value.Bio
					</p>
				</div>
				@if (isAuthorized)
				{
					<div class="user-dob">
						<p>
							<strong>Date of Birth:</strong>
							@user.Value.DateOfBirth
						</p>
					</div>
				}
				<AuthorizeView Roles="Admin, Moderator" Context="authState">
					<Authorized>
						<div class="user-dob">
							<p>
								<strong>User Date of Birth:</strong>
								@user.Value.DateOfBirth
							</p>
						</div>
					</Authorized>
				</AuthorizeView>
			}
			@if (isAuthorized && !isBanned)
			{
				<button class="btn btn-primary" onclick="@(() => CustomizeUserPage(UserName!))">
					Customize Profile
				</button>
			}
			<AuthorizeView Roles="Admin, Moderator" Context="authState">
				<Authorized>
					<button class="btn btn-primary" onclick="@(() => AdminEditUserPage(UserName!))">
						Edit User (Admin)
					</button>
					<button class="btn btn-secondary" onclick="@(() => UpdateUserRole(UserName!))">
						Update Role
					</button>
				</Authorized>
			</AuthorizeView>
		}
	</div>
	<div class="right-column"></div>
</div>




@code {
	[Parameter]
	public string? UserName { get; set; }
	private UserResponse? user = new UserResponse();

	private string userRole = "";

	private bool isAuthorized = false;
	private bool isBanned = false;
	private bool isLoading = true;


	protected override async Task OnInitializedAsync()
	{
		var resultingUserRoles = await UserService.GetUserRole(UserName!);
		if (resultingUserRoles.Count > 0)
		{
			userRole = resultingUserRoles[0];
		}
	}

	protected override async Task OnParametersSetAsync()
	{
		if (string.IsNullOrWhiteSpace(UserName))
		{
			NavigationManager.NavigateTo("notfound");
			return;
		}
		else
		{
			try
			{
				var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
				var user = authState.User;
				var currentUserName = user.Identity!.Name;
				isAuthorized = string.Equals(currentUserName, UserName, StringComparison.OrdinalIgnoreCase);
			}
			catch (Exception ex)
			{
				Logger.LogError(ex, $"Error during authorization check for user {UserName}", UserName);
				NavigationManager.NavigateTo("notfound");
				return;
			}
			finally
			{
				isLoading = false;
			}
			var result = await UserService.GetUserAsync(UserName);
			if (result == null)
			{
				NavigationManager.NavigateTo("notfound");
				return;
			}
			else
			{
				user = result;
				isBanned = user.Value.IsBanned;
			}
		}
	}

	private void CustomizeUserPage(string userName)
	{
		NavigationManager.NavigateTo($"/users/{userName}/customize");
	}

	private void AdminEditUserPage(string userName)
	{
		NavigationManager.NavigateTo($"/users/{userName}/admin");
	}

	private void UpdateUserRole(string userName)
	{
		NavigationManager.NavigateTo($"/users/{userName}/roles");
	}
}

