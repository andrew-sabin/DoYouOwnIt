@page "/site-news/createArticle"
@page "/site-news/article/{slug}/edit"
@inject IAuthService authService
@inject INewsBlogService articleService
@inject IAuthService AuthService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider

@inject IJSRuntime JSRuntime
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.Buttons
@using System.Text.Json
@using System.ComponentModel.DataAnnotations
@attribute [Authorize(Roles = "Admin")]


<h3>Edit Article</h3>

@if (isLoading)
{
    <p><strong>Loading Article Information Please Wait...</strong></p>
    <div class="spinner-border" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
}
else
{
    @if (!string.IsNullOrWhiteSpace(slug))
    {
        <PageTitle>Editing Blog: @article.Title - DoYouOwnIt</PageTitle>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">Home</li>
                <li class="breadcrumb-item">News</li>
                <li class="breadcrumb-item active">@article.Title</li>
            </ol>
        </nav>

        <h3>Edit Article @article.Title</h3>
    }
    else
    {
        <PageTitle>Creating a New Article - DoYouOwnIt</PageTitle>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">Home</li>
                <li class="breadcrumb-item">News</li>
                <li class="breadcrumb-item active">New Article</li>
            </ol>
        </nav>

        <h3>Create a New Article</h3>
    }
    @if (!String.IsNullOrEmpty(article.CoverImageUrl) && String.IsNullOrEmpty(FileUrl))
    {
        <div class="mb-3">
            <h3>Current Cover Image</h3>
            <img src="@article.CoverImageUrl" alt="Current Format Cover Image" style="max-width: 200px; max-height: 300px;" />
        </div>
    }
    else if (!String.IsNullOrEmpty(article.CoverImageUrl) && !String.IsNullOrEmpty(FileUrl))
    {
        <div class="mb-3">
            <h3>Current Cover Image</h3>
            <img src="@article.CoverImageUrl" alt="Current Format Cover Image" style="max-width: 200px; max-height: 300px;" />
        </div>
        <div class="mb-3">
            <h3>New Cover Image</h3>
            <img src="@FileUrl" alt="Format Cover Image" style="max-width: 200px; max-height: 300px;" />
        </div>
    }
    else if (String.IsNullOrEmpty(article.CoverImageUrl) && !String.IsNullOrEmpty(FileUrl))
    {
        <div class="mb-3">
            <h3>New Cover Image</h3>
            <img src="@FileUrl" alt="Format Cover Image" style="max-width: 200px; max-height: 300px;" />
        </div>
    }
    <EditForm Model="@article">
        <div class="form-group">
            <label for="articleTitle">Title</label>
            <InputText id="articleTitle" class="form-control" @bind-Value="article.Title" />
        </div>
        <div class="form-group">
            <label for="articleType">Article Type</label>
            <InputText id="articleType" class="form-control" @bind-Value="article.ArticleType" />
        </div>
        @if (!string.IsNullOrWhiteSpace(slug))
        {
            <div class="form-group">
                <label for="articleSlug">Slug</label>
                <InputText id="articleSlug" class="form-control" @bind-Value="article.Slug" />
            </div>
        }
        <div class="form-group">
            <label for="articleCover">Article Cover</label>
            <SfUploader ID="UploadFiles" AutoUpload="true" AllowedExtensions=".jpg,.jpeg,.png,.gif,.svg" EnableHtmlSanitizer="true">
                <UploaderAsyncSettings SaveUrl="/api/Image/Save" RemoveUrl="/api/Image/DeleteFile"></UploaderAsyncSettings>
                <UploaderEvents FileSelected="@OnFileSelected" BeforeRemove="@OnBeforeFileRemoved" ValueChange="@OnChange" Success="@OnSuccess"></UploaderEvents>
            </SfUploader>
        </div>
        <div class="form-group">
            <label for="articleSticky">Stick To Front Page</label>
            <InputCheckbox id="articleSticky" class="form-check-input" @bind-Value="article.StickToFrontPage" />
        </div>
        <div class="form-group">
            <label for="articleNews">News Article</label>
            <RichTextEditor @ref="myEditor" Content="@article.NewsArticle" Placeholder="Please enter in a site update here..."
                            ContainerName="blog" ProductSlug="@article.Slug" MaxLength="100000" imageLimit="10" videoLimit="10" audioLimit="10" saveDirectory="https://images.gmntgstrg.com/blog/" />
        </div>
    </EditForm>
    <button type="submit" class="btn btn-primary mt-4" @onclick="HandleValidSubmit">Submit</button>
    <button type="button" class="btn btn-secondary mt-4 mx-1" @onclick="CancelEdit">Cancel</button>
}



@code {
    [Parameter]
    public string? slug { get; set; }

    private RichTextEditor? myEditor;
    private NewsBlogRequest article = new NewsBlogRequest();

    private List<string> savedFiles = new();
    private List<string> fileLocations = new();
    private List<Syncfusion.Blazor.Inputs.FileInfo> uploadedFiles = new();

    private bool isLoading = false;

    public string? FileUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await authService.EnsureTokenValidAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        await AuthService.EnsureTokenValidAsync();
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (!user.Identity?.IsAuthenticated ?? true)
        {
            NavigationManager.NavigateTo("notfound");
            return;
        }
        if (!string.IsNullOrWhiteSpace(slug))
        {
            var result = await articleService.GetArticleBySlug(slug);
            article = new NewsBlogRequest
                {
                    Id = result.Value.Id,
                    Title = result.Value.Title,
                    ArticleType = result.Value.ArticleType,
                    StickToFrontPage = result.Value.StickToFrontPage,
                    CoverImageUrl = result.Value.CoverImageUrl,
                    Slug = result.Value.slug,
                    AuthorId = result.Value.AuthorId,
                    ModifierId = result.Value.ModifierId,
                    NewsArticle = result.Value.NewsArticle
                };
        }
        isLoading = false;
    }

    private async Task OnFileSelected(SelectedEventArgs args)
    {
        if (string.IsNullOrEmpty(article.Slug))
        {
            args.CurrentRequest = new List<object> { new { Authorization = "" }, new { containerName = "blog" },
            new { blobDirectory = "newly-created" + "/cover-image"} };
        }
        else
        {
            args.CurrentRequest = new List<object> { new { Authorization = "" }, new { containerName = "blog" },
            new { blobDirectory = article.Slug + "/cover-image"} };
        }
        
    }

    private async Task OnBeforeFileRemoved(BeforeRemoveEventArgs args)
    {
        if (string.IsNullOrEmpty(article.Slug))
        {
            args.CurrentRequest = new List<object> { new { Authorization = "" }, new { containerName = "blog" },
            new { blobDirectory = "newly-created" + "/cover-image"} };
        }
        else
        {
            args.CurrentRequest = new List<object> { new { Authorization = "" }, new { containerName = "blog" },
            new { blobDirectory = article.Slug + "/cover-image"} };
        }
    }

    private async Task OnChange(UploadChangeEventArgs args)
    {
        uploadedFiles.Clear();
        if (args?.Files != null)
        {
            foreach (var f in args.Files)
            {
                uploadedFiles.Add(f.FileInfo);
            }
        }
    }

    private void ParseResponseString(string json)
    {
        using var doc = System.Text.Json.JsonDocument.Parse(json);
        ParseResponseJsonElement(doc.RootElement);
    }

    private void ParseResponseJsonElement(JsonElement root)
    {
        if (root.ValueKind == System.Text.Json.JsonValueKind.Object)
        {
            if (root.TryGetProperty("files", out var files) && files.ValueKind == JsonValueKind.Array)
            {
                foreach (var f in files.EnumerateArray())
                {
                    var name = f.GetString();
                    if (!string.IsNullOrEmpty(name) && !savedFiles.Contains(name))
                        savedFiles.Add(name);
                }
            }

            if (root.TryGetProperty("fileLocations", out var locs) && locs.ValueKind == JsonValueKind.Array)
            {
                foreach (var l in locs.EnumerateArray())
                {
                    var loc = l.GetString();
                    if (!string.IsNullOrEmpty(loc) && !fileLocations.Contains(loc))
                        fileLocations.Add(loc);
                }
            }
        }
    }

    private void OnSuccess(SuccessEventArgs args)
    {
        try
        {
            if (args == null) return;

            var response = args.Response.ResponseText;
            if (response == null)
                return;
            ParseResponseString(response);

            // Console.WriteLine($"Server saved files: {string.Join(',', savedFiles)}");
            // Console.WriteLine($"Server saved files: {string.Join(',', fileLocations)}");
            FileUrl = fileLocations[0];
        }
        catch (Exception ex)
        {
            Console.WriteLine($"OnSuccess parse error: {ex.Message}");
            FileUrl = null;
        }
    }

    async Task HandleValidSubmit()
    {
        await authService.EnsureTokenValidAsync();
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (!user.Identity?.IsAuthenticated ?? true)
        {
            NavigationManager.NavigateTo("notfound");
            return;
        }
        if (!string.IsNullOrEmpty(FileUrl))
            article.CoverImageUrl = FileUrl;

        if (string.IsNullOrWhiteSpace(slug))
        {
            article.NewsArticle = myEditor?.Content ?? string.Empty;
            await articleService.CreateArticle(article);
            NavigationManager.NavigateTo("/site-news");
        }
        else
        {
            article.NewsArticle = myEditor?.Content ?? string.Empty;
            await articleService.UpdateArticle(article.Id, article);
            NavigationManager.NavigateTo($"/site-news/article/{slug}");
        }
    }
    async Task CancelEdit()
    {
        if (string.IsNullOrWhiteSpace(slug))
            NavigationManager.NavigateTo("/site-news");
        else
            NavigationManager.NavigateTo($"/site-news/article/{slug}");
    }
}
